{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quality-audit-kit/report.schema.json",
  "title": "Quality Audit Kit structured report",
  "description": "Deterministic derived report for one audit run. No global quality score is part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sha", "basis"],
      "properties": {
        "status": { "enum": ["VERIFIED", "UNVERIFIED", "UNKNOWN"] },
        "sha": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{40}$" },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "functionMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurementId", "engine", "engineVersion", "metricId", "metricVersion", "language", "path", "functionId", "functionName", "astRole", "startLine", "endLine", "value", "unit", "direction", "status", "provenance", "evidenceRef"],
      "properties": {
        "measurementId": { "type": "string", "minLength": 8 },
        "engine": { "type": "string", "minLength": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "metricId": { "type": "string", "minLength": 1 },
        "metricVersion": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "functionId": { "type": "string", "minLength": 1 },
        "functionName": { "type": "string", "minLength": 1 },
        "astRole": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["LOWER_IS_BETTER", "HIGHER_IS_BETTER"] },
        "status": { "const": "MEASURED" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "sourceRevision"],
          "properties": {
            "kind": { "enum": ["REPORT", "EXECUTION"] },
            "reference": { "type": "string", "minLength": 1 },
            "sourceRevision": { "$ref": "#/$defs/sourceRevision" },
            "contentSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
          }
        },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "subtreeStartLine": { "type": ["integer", "null"], "minimum": 1 },
        "subtreeEndLine": { "type": ["integer", "null"], "minimum": 1 },
        "subtreeRootKind": { "type": ["string", "null"] }
      }
    },
    "maintainabilityCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "eligibleFiles", "measuredFiles", "excludedFiles", "unsupportedFiles", "errorFiles", "functionsMeasured", "engines"],
      "properties": {
        "schemaVersion": { "const": "0.1-draft" },
        "status": { "enum": ["MEASURED", "PARTIAL", "NOT_MEASURED", "FAILURE", "SKIPPED_BY_POLICY"] },
        "reason": { "type": "string" },
        "eligibleFiles": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "measuredFiles": { "type": "array", "items": { "type": "string" } },
        "excludedFiles": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "unsupportedFiles": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "errorFiles": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "functionsMeasured": { "type": "integer", "minimum": 0 },
        "engines": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    }
  },
  "required": [
    "schemaVersion",
    "reportVersion",
    "reportType",
    "runId",
    "source",
    "measurements",
    "findings",
    "measurementFailures",
    "recommendations"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1-draft" },
    "reportVersion": { "const": "0.1-draft" },
    "reportType": { "const": "QUALITY_AUDIT_RUN_REPORT" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,80}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "contextSha", "inputScope", "reproducible", "generatedAt"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "contextSha": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{40}$" },
        "inputScope": { "enum": ["COMMITTED_SNAPSHOT", "STAGED", "WORKTREE_LIVE"] },
        "reproducible": { "type": "boolean" },
        "generatedAt": { "type": ["string", "null"] }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "sha", "contextSha", "scope", "engine", "version", "measurementStatus", "validationState", "sourceRevision", "gateOutcome"],
        "properties": {
          "runId": { "type": "string" },
          "sha": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{40}$" },
          "contextSha": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{40}$" },
          "scope": { "type": "string" },
          "engine": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "measurementStatus": { "enum": ["MEASURED", "PARTIAL", "NOT_MEASURED", "FAILURE", "SKIPPED_BY_POLICY"] },
          "validationState": { "enum": ["VALIDATED", "MEASURED_UNVERIFIED", "FAILED", "NOT_MEASURED", "SKIPPED"] },
          "sourceRevision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "sha", "basis"],
            "properties": {
              "status": { "enum": ["VERIFIED", "UNVERIFIED", "UNKNOWN"] },
              "sha": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{40}$" },
              "basis": { "type": "string", "minLength": 1 }
            }
          },
          "gateOutcome": { "enum": ["PASS", "FAIL", "INFORMATIVE", "NOT_EVALUATED"] },
          "diagnostic": { "type": "string" }
        }
      }
    },
    "functionMeasurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/functionMeasurement" }
    },
    "maintainabilityCoverage": {
      "$ref": "#/$defs/maintainabilityCoverage"
    },
    "structuralComplexity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "functionId", "functionName", "astRole", "startLine", "endLine", "decisionCount", "maxDecisionDepth", "nestedDecisionCount", "maxSubtreeDecisionCount", "signals", "explanation"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "functionId": { "type": "string", "minLength": 1 },
          "functionName": { "type": "string", "minLength": 1 },
          "astRole": { "type": "string", "minLength": 1 },
          "startLine": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "decisionCount": { "type": "number", "minimum": 0 },
          "maxDecisionDepth": { "type": "number", "minimum": 0 },
          "nestedDecisionCount": { "type": "number", "minimum": 0 },
          "maxSubtreeDecisionCount": { "type": "number", "minimum": 0 },
          "maxSubtreeStartLine": { "type": ["integer", "null"], "minimum": 1 },
          "maxSubtreeEndLine": { "type": ["integer", "null"], "minimum": 1 },
          "maxSubtreeRootKind": { "type": ["string", "null"] },
          "signals": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "explanation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new", "historicalActionable", "historicalJustified", "resolved", "reintroduced", "unclassified"],
      "properties": {
        "new": { "type": "array", "items": { "type": "object" } },
        "historicalActionable": { "type": "array", "items": { "type": "object" } },
        "historicalJustified": { "type": "array", "items": { "type": "object" } },
        "resolved": { "type": "array", "items": { "type": "object" } },
        "reintroduced": { "type": "array", "items": { "type": "object" } },
        "unclassified": { "type": "array", "items": { "type": "object" } }
      }
    },
    "clones": { "type": "object", "additionalProperties": true },
    "measurementFailures": { "type": "array", "items": { "type": "object" } },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "diagnostics": { "type": "array", "items": { "type": "object" } },
    "comparison": { "type": "object" },
    "qualityGate": { "type": "object" }
  }
}
