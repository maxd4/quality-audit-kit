{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quality-audit-kit/audit-run.schema.json",
  "title": "Quality Audit Kit draft audit run",
  "description": "DESIGN v0.1: not a published stable API.",
  "$defs": {
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sha",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED",
            "UNKNOWN"
          ]
        },
        "sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "status"],
      "anyOf": [
        { "required": ["value"] },
        { "required": ["values"] }
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "number", "minimum": 0 },
        "values": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 1
        },
        "unit": { "type": "string", "minLength": 1 },
        "status": { "enum": ["MEASURED", "NOT_MEASURED", "FAILURE", "UNAVAILABLE"] },
        "direction": { "enum": ["LOWER_IS_BETTER", "HIGHER_IS_BETTER"] },
        "language": { "type": "string" },
        "workspace": { "type": "string" },
        "fileCategory": { "enum": ["runtime", "tests", "configuration", "generated", "unknown"] },
        "scope": { "type": "string" },
        "findingCount": { "type": "integer", "minimum": 0 },
        "findingIds": { "type": "array", "items": { "type": "string" } },
        "degraded": { "type": "boolean" },
        "qualityState": { "type": "string" },
        "provenance": { "type": "object", "additionalProperties": true }
      }
    },
    "functionMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurementId", "engine", "engineVersion", "metricId", "metricVersion", "language", "path",
        "functionId", "functionName", "astRole", "startLine", "endLine", "value", "unit", "direction",
        "status", "provenance", "evidenceRef"
      ],
      "properties": {
        "measurementId": { "type": "string", "minLength": 8 },
        "engine": { "type": "string", "minLength": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "metricId": { "type": "string", "minLength": 1 },
        "metricVersion": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "functionId": { "type": "string", "minLength": 1 },
        "functionName": { "type": "string", "minLength": 1 },
        "astRole": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["LOWER_IS_BETTER", "HIGHER_IS_BETTER"] },
        "status": { "enum": ["MEASURED", "NOT_MEASURED", "FAILURE", "SKIPPED_BY_POLICY"] },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "sourceRevision"],
          "properties": {
            "kind": { "enum": ["REPORT", "EXECUTION"] },
            "reference": { "type": "string", "minLength": 1 },
            "sourceRevision": { "$ref": "#/$defs/sourceRevision" },
            "contentSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
          }
        },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "maintainabilityCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "eligibleFiles", "measuredFiles", "excludedFiles", "unsupportedFiles", "errorFiles", "functionsMeasured", "engines"],
      "properties": {
        "schemaVersion": { "const": "0.1-draft" },
        "status": { "enum": ["MEASURED", "PARTIAL", "NOT_MEASURED", "FAILURE", "SKIPPED_BY_POLICY"] },
        "reason": { "type": "string" },
        "eligibleFiles": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "measuredFiles": { "type": "array", "items": { "type": "string" } },
        "excludedFiles": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "unsupportedFiles": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "errorFiles": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "functionsMeasured": { "type": "integer", "minimum": 0 },
        "engines": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "repository",
    "inputScope",
    "reproducible",
    "engines",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1-draft"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,80}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "contextCommitSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "sourceScopeDescription": {
          "type": "string"
        }
      }
    },
    "inputScope": {
      "enum": [
        "COMMITTED_SNAPSHOT",
        "STAGED",
        "WORKTREE_LIVE"
      ]
    },
    "reproducible": {
      "type": "boolean"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "compatible",
        "baselineRunId",
        "currentRunId",
        "matches",
        "resolved",
        "reasons",
        "staleDecisions"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPATIBLE",
            "NOT_EVALUATED"
          ]
        },
        "compatible": {
          "type": "boolean"
        },
        "baselineRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "staleDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policy",
        "blockedReasons",
        "newBlockingFindings",
        "proposals",
        "policyRelaxation"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUATED"
          ]
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockingSeverities",
            "maxNewBlockingFindings",
            "maxMeasuredFindings"
          ],
          "properties": {
            "blockingSeverities": {
              "type": "array",
              "items": {
                "enum": [
                  "INFO",
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              }
            },
            "maxNewBlockingFindings": {
              "type": "integer",
              "minimum": 0
            },
            "maxMeasuredFindings": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "blockedReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "newBlockingFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "policyRelaxation": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "createdAt",
        "history",
        "policySnapshot"
      ],
      "properties": {
        "kind": {
          "const": "QUALITY_BASELINE"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "policySnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockingSeverities",
            "maxNewBlockingFindings",
            "maxMeasuredFindings"
          ],
          "properties": {
            "blockingSeverities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maxNewBlockingFindings": {
              "type": "integer",
              "minimum": 0
            },
            "maxMeasuredFindings": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "replacedBaselineRunId": {
          "type": "string"
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryRoot",
        "packageManager",
        "languages",
        "workspaces",
        "scanners",
        "configurations"
      ],
      "properties": {
        "repositoryRoot": {
          "const": "."
        },
        "packageManager": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "lockfile"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "lockfile": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workspaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared",
            "packages"
          ],
          "properties": {
            "declared": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "scanners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "installed",
              "configuration",
              "packageConfiguration",
              "scripts"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "installed": {
                "type": "boolean"
              },
              "configuration": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "packageConfiguration": {
                "type": "boolean"
              },
              "scripts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "configurations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scanner",
              "path"
            ],
            "properties": {
              "scanner": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "head": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-fA-F0-9]{40}$"
            },
            "worktree": {
              "enum": [
                "CLEAN",
                "DIRTY",
                "UNKNOWN"
              ]
            }
          }
        }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "projectKey", "version", "sourceRevision"],
      "properties": {
        "name": { "type": "string" },
        "projectKey": { "type": "string" },
        "branch": { "type": ["string", "null"] },
        "version": { "type": "string" },
        "sourceRevision": { "$ref": "#/$defs/sourceRevision" }
      }
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "measurementStatus",
          "gateOutcome"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          },
          "measurementStatus": {
            "enum": [
              "MEASURED",
              "PARTIAL",
              "NOT_MEASURED",
              "FAILURE",
              "SKIPPED_BY_POLICY"
            ]
          },
          "gateOutcome": {
            "enum": [
              "PASS",
              "FAIL",
              "INFORMATIVE",
              "NOT_EVALUATED"
            ]
          },
          "diagnostic": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "gateRelevant": {
            "type": "boolean"
          },
          "connector": { "type": "string" },
          "projectKey": { "type": "string" },
          "branch": { "type": "string" },
          "pullRequest": { "type": "string" },
          "metadata": { "type": "object", "additionalProperties": true },
          "sourceRevision": {
            "$ref": "#/$defs/sourceRevision"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "engine",
          "ruleId",
          "path",
          "severity",
          "message",
          "lifecycle",
          "measurementStatus",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 8
          },
          "engine": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "enum": [
              "INFO",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "enum": [
              "NEW",
              "HISTORICAL_ACTIONABLE",
              "HISTORICAL_JUSTIFIED",
              "RESOLVED",
              "REINTRODUCED",
              "UNCLASSIFIED"
            ]
          },
          "measurementStatus": {
            "enum": [
              "MEASURED",
              "PARTIAL",
              "NOT_MEASURED",
              "FAILURE",
              "SKIPPED_BY_POLICY"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reference"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "REPORT",
                  "EXECUTION"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "sourceRevision": {
                "$ref": "#/$defs/sourceRevision"
              }
            }
          },
          "rawReference": {
            "type": "string"
          },
          "clone": {
            "type": "object",
            "additionalProperties": true
          },
          "planning": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "responsibility": { "type": "string" },
              "category": { "type": "string" },
              "planCategory": { "type": "string" },
              "commonCauseId": { "type": "string" },
              "commonCauseEvidence": { "type": "string" },
              "commonCauseConfirmed": { "type": "boolean" },
              "confidence": { "type": "string" },
              "consumers": { "type": "array", "items": { "type": "string" } },
              "consumerCount": { "type": "integer", "minimum": 0 },
              "estimatedCost": { "type": "string" },
              "changeRisk": { "type": "string" },
              "dependsOnFindings": { "type": "array", "items": { "type": "string" } },
              "dependsOnCauseId": { "type": "string" },
              "securityConfirmed": { "type": "boolean" },
              "contractBroken": { "type": "boolean" },
              "causeType": { "type": "string" },
              "justified": { "type": "boolean" },
              "falsePositive": { "type": "boolean" }
            }
          }
        }
      }
    },
    "functionMeasurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/functionMeasurement" }
    },
    "maintainabilityCoverage": {
      "$ref": "#/$defs/maintainabilityCoverage"
    },
    "clones": {
      "type": "object",
      "additionalProperties": true
    },
    "metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/metric" }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "code", "message"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "reference": { "type": "string" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
